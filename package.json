{
  "name": "mindest",
  "version": "1.0.0",
  "private": true,
  "description": "Mindest – tổ ấm cho tâm trí. Bài nhận diện phong cách ứng phó dành cho người trẻ Việt Nam.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "next lint",
    "format": "prettier --write .",
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:content": "node scripts/lint-content.mjs",
    "check": "npm run lint && npm run lint:content && npm run test && npm run build"
  },
  "dependencies": {
    "@dicebear/collection": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@react-pdf/renderer": "4.9.0",
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "patch-package": "^8.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
